# 复制为 .env 后填写。.env 已被 .gitignore 忽略。

# 模型来源：deepseek（真实模型）| mock（离线规则 Mock，只验证流程，不代表模型决策效果）
LLM_MODE=deepseek

# DeepSeek，OpenAI 兼容协议。换别家兼容服务只改这三项
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 模型调用超时（秒）
LLM_TIMEOUT=60

# "今天"的日期。判断制度是否已生效时用它，固定下来测试才可复现
KBQA_TODAY=2026-10-28

# 每轮问答最多调用模型几次（核验退回也算一次），到上限返回 INCOMPLETE
KBQA_MAX_STEPS=8
# 每轮问答最多执行几次工具
KBQA_MAX_TOOL_CALLS=15

# 会话库位置
KBQA_DB_PATH=var/sessions.db
